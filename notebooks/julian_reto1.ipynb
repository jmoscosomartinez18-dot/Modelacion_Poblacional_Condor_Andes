    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scripts.metodos_numericos import modelo_logistico, metodo_heun, crear_tabla\n",
    "\n",
    "# Cargar datos de Samuel\n",
    "datos = pd.read_csv('../data/datos_poblacion_condor.csv')\n",
    "\n",
    "# Parámetros del modelo\n",
    "r = 0.04\n",
    "K_base = 250\n",
    "P0 = 63\n",
    "tiempo_total = 50\n",
    "pasos = 50\n",
    "\n",
    "# 🟢 ESCENARIO 1: CONSERVACIÓN BUENA\n",
    "t1, P1 = metodo_heun(modelo_logistico, 0, tiempo_total, P0, pasos, r, 250)\n",
    "tabla1 = crear_tabla(t1, P1, \"Conservación buena\")\n",
    "\n",
    "# 🟠 ESCENARIO 2: DEFORESTACIÓN\n",
    "t2, P2 = metodo_heun(modelo_logistico, 0, tiempo_total, P0, pasos, r, 150)\n",
    "tabla2 = crear_tabla(t2, P2, \"Deforestación\")\n",
    "\n",
    "# 🔴 ESCENARIO 3: CAZA / ENVENENAMIENTO\n",
    "t3, P3 = metodo_heun(modelo_logistico, 0, tiempo_total, P0, pasos, 0.015, 200)\n",
    "tabla3 = crear_tabla(t3, P3, \"Caza y envenenamiento\")\n",
    "\n",
    "# Gráfica comparativa\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.plot(t1, P1, 'g-', linewidth=2, label='Conservación')\n",
    "plt.plot(t2, P2, 'orange', linewidth=2, label='Deforestación')\n",
    "plt.plot(t3, P3, 'r-', linewidth=2, label='Caza')\n",
    "plt.scatter(datos['anio'] - 2025, datos['poblacion'], color='blue', s=50, label='Datos reales')\n",
    "plt.title('Evolución del Cóndor de los Andes')\n",
    "plt.xlabel('Años desde 2025')\n",
    "plt.ylabel('Número de individuos')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
