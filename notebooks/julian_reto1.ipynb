import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scripts.metodos_numericos import modelo_logistico, metodo_heun, crear_tabla

# Cargar datos de Samuel
datos = pd.read_csv('../data/datos_poblacion_condor.csv')

# Parámetros
r = 0.04
K_base = 250
P0 = 63
tiempo_total = 50
pasos = 50

# 🟢 ESCENARIO 1: CONSERVACIÓN BUENA
t1, P1 = metodo_heun(modelo_logistico, 0, tiempo_total, P0, pasos, r, 250)
tabla1 = crear_tabla(t1, P1, "Conservación buena")

# 🟠 ESCENARIO 2: DEFORESTACIÓN
t2, P2 = metodo_heun(modelo_logistico, 0, tiempo_total, P0, pasos, r, 150)
tabla2 = crear_tabla(t2, P2, "Deforestación")

# 🔴 ESCENARIO 3: CAZA / ENVENENAMIENTO
t3, P3 = metodo_heun(modelo_logistico, 0, tiempo_total, P0, pasos, 0.015, 200)
tabla3 = crear_tabla(t3, P3, "Caza y envenenamiento")

# Gráfica
plt.figure(figsize=(10,6))
plt.plot(t1, P1, 'g-', linewidth=2, label='Conservación')
plt.plot(t2, P2, 'orange', linewidth=2, label='Deforestación')
plt.plot(t3, P3, 'r-', linewidth=2, label='Caza')
plt.scatter(datos['anio'] - 2025, datos['poblacion'], color='blue', s=50, label='Datos reales')
plt.title('Evolución del Cóndor de los Andes')
plt.xlabel('Años desde 2025')
plt.ylabel('Número de individuos')
plt.legend()
plt.grid(True)
plt.show()